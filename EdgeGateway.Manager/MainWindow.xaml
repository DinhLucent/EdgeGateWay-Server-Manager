<Window x:Class="EdgeGateway.Manager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:EdgeGateway.Manager"
        xmlns:core="clr-namespace:EdgeGateway.Core.Models;assembly=EdgeGateway.Core"
        Title="EdgeGateway Device Manager"
        Icon="logo.png"
        Height="720"
        Width="1100"
        MinHeight="640"
        MinWidth="980"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        FontSize="12"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <local:StatusBrushConverter x:Key="StatusBrushConverter" />
        <local:DashboardCountBackgroundConverter x:Key="DashboardCountBackgroundConverter" />
        <Style x:Key="RightAlignedCellText" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style x:Key="DenseDashboardCell" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
            <Setter Property="Padding" Value="6,2" />
        </Style>
        <Style x:Key="OutputQueueDashboardCell" TargetType="DataGridCell" BasedOn="{StaticResource DenseDashboardCell}">
            <Setter Property="Background" Value="{Binding OutputQueuedCount, Converter={StaticResource DashboardCountBackgroundConverter}}" />
        </Style>
        <Style x:Key="OrderQueueDashboardCell" TargetType="DataGridCell" BasedOn="{StaticResource DenseDashboardCell}">
            <Setter Property="Background" Value="{Binding OrderQueuedCount, Converter={StaticResource DashboardCountBackgroundConverter}}" />
        </Style>
        <Style x:Key="ErroredDashboardCell" TargetType="DataGridCell" BasedOn="{StaticResource DenseDashboardCell}">
            <Setter Property="Background" Value="{Binding ErroredCount, Converter={StaticResource DashboardCountBackgroundConverter}, ConverterParameter=error}" />
        </Style>
        <Style TargetType="GroupBox" BasedOn="{StaticResource {x:Type GroupBox}}">
            <Setter Property="Margin" Value="0,2,8,6" />
            <Setter Property="Padding" Value="8,6" />
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="LogDetailTextBox" TargetType="TextBox" BasedOn="{StaticResource LogDetailTextBox}" />
        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="Padding" Value="10,2" />
        </Style>
        <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}" />
    </Window.Resources>

    <DockPanel Background="{StaticResource BackgroundBrush}">

        <!-- Modern Header -->
        <Border DockPanel.Dock="Top"
                Height="48"
                Background="{StaticResource HeaderBackgroundBrush}"
                Padding="16,0"
                BorderBrush="{StaticResource HeaderBorderBrush}"
                BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                    <Image Source="app-logo-alt.png" Width="24" Height="24" Margin="0,0,10,0" SnapsToDevicePixels="True" />
                    <TextBlock Text="EdgeGateway Device Manager"
                               Foreground="White"
                               FontSize="15"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Right">
                    <!-- Service Status Pill -->
                    <Border Background="{StaticResource HeaderInputBackgroundBrush}"
                            BorderBrush="{StaticResource HeaderInputBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="8,2"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Service: " Foreground="White" Opacity="0.75" FontSize="11" VerticalAlignment="Center" />
                            <TextBlock x:Name="ServiceStatusTextBlock" Text="unknown" Foreground="White" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Access Role Pill -->
                    <Border Background="{StaticResource HeaderInputBackgroundBrush}"
                            BorderBrush="{StaticResource HeaderInputBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="8,2">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Role: " Foreground="White" Opacity="0.75" FontSize="11" VerticalAlignment="Center" />
                            <TextBlock x:Name="AccessRoleTextBlock" Text="Role: unknown" Foreground="White" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Styled Menu -->
        <Menu DockPanel.Dock="Top" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="6,3">
            <MenuItem Header="_Service">
                <MenuItem x:Name="StartServiceMenuItem" Header="_Start runtime" Click="StartService_Click" />
                <MenuItem x:Name="StopServiceMenuItem" Header="S_top runtime" Click="StopService_Click" />
                <Separator />
                <MenuItem x:Name="ReloadRuntimeMenuItem" Header="_Reload runtime config" Click="ReloadRuntime_Click" />
            </MenuItem>
            <MenuItem Header="_Config">
                <MenuItem x:Name="ExportConfigMenuItem" Header="_Export config bundle" Click="ExportConfigBundle_Click" />
                <MenuItem x:Name="ImportConfigMenuItem" Header="_Import config bundle" Click="ImportConfigBundle_Click" />
                <MenuItem x:Name="RestoreConfigMenuItem" Header="_Restore config backup" Click="RestoreConfigBackup_Click" />
            </MenuItem>
            <MenuItem Header="_Devices">
                <MenuItem x:Name="ConnectAllMenuItem" Header="_Connect all" Click="ConnectAll_Click" />
                <MenuItem x:Name="DisconnectAllMenuItem" Header="_Disconnect all" Click="DisconnectAll_Click" />
            </MenuItem>
        </Menu>

        <!-- Control Bar -->
        <Border DockPanel.Dock="Top"
                Background="{StaticResource SurfaceMutedBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,6">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock VerticalAlignment="Center" Text="Dashboard" FontWeight="SemiBold" Foreground="{StaticResource TextDarkBrush}" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock VerticalAlignment="Center" Text="Auto Refresh" Foreground="{StaticResource TextMutedBrush}" />
                    <TextBox x:Name="RefreshSecondsTextBox"
                              Width="42"
                              Height="22"
                              Margin="6,0"
                              HorizontalContentAlignment="Right"
                              Text="5" />
                    <TextBlock VerticalAlignment="Center" Text="sec" Foreground="{StaticResource TextMutedBrush}" />
                    <Button Margin="10,0,0,0" Height="22" Content="Refresh Now" Click="Refresh_Click" />
                </StackPanel>
            </DockPanel>
        </Border>

        <StatusBar DockPanel.Dock="Bottom" Height="26">
            <StatusBarItem>
                <TextBlock x:Name="StatusTextBlock" Text="Ready" />
            </StatusBarItem>
        </StatusBar>

        <Grid Margin="8">
            <TabControl x:Name="MainTabs" SelectedIndex="0">
                <TabItem Header="Dashboard">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="76" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="150" />
                        </Grid.RowDefinitions>
                        <UniformGrid Grid.Row="0" Columns="5">
                            <GroupBox Header="SERVICE" Style="{StaticResource KpiCardStyle}">
                                <TextBlock x:Name="DashboardServiceTextBlock"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource PrimaryBrush}"
                                           Text="Unknown"
                                           VerticalAlignment="Center" />
                            </GroupBox>
                            <GroupBox Header="DEVICES" Style="{StaticResource KpiCardStyle}">
                                <TextBlock x:Name="DashboardDeviceCountTextBlock"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource PrimaryBrush}"
                                           Text="0"
                                           VerticalAlignment="Center" />
                            </GroupBox>
                            <GroupBox Header="OUTPUT QUEUE" Style="{StaticResource KpiCardStyle}">
                                <TextBlock x:Name="DashboardOutputQueueTextBlock"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource PrimaryBrush}"
                                           Text="0"
                                           VerticalAlignment="Center" />
                            </GroupBox>
                            <GroupBox Header="ORDER QUEUE" Style="{StaticResource KpiCardStyle}">
                                <TextBlock x:Name="DashboardOrderQueueTextBlock"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource PrimaryBrush}"
                                           Text="0"
                                           VerticalAlignment="Center" />
                            </GroupBox>
                            <GroupBox Header="ERRORED" Style="{StaticResource KpiCardStyle}">
                                <TextBlock x:Name="DashboardErroredTextBlock"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource ErrorBrush}"
                                           Text="0"
                                           VerticalAlignment="Center" />
                            </GroupBox>
                        </UniformGrid>

                        <GroupBox Grid.Row="1" Header="Device Queues and Connections">
                            <DataGrid x:Name="DashboardDevicesGrid"
                                      CellStyle="{StaticResource DenseDashboardCell}"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="Status" Width="112">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="12" Padding="8,3" HorizontalAlignment="Center" VerticalAlignment="Center" BorderThickness="1">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <!-- Default state (Warning) -->
                                                            <Setter Property="Background" Value="#FEF3C7" />
                                                            <Setter Property="BorderBrush" Value="#FDE68A" />
                                                            <Style.Triggers>
                                                                <!-- Connected / Listening -->
                                                                <DataTrigger Binding="{Binding Status}" Value="{x:Static core:DeviceConnectionStatus.Connected}">
                                                                    <Setter Property="Background" Value="#D1FAE5" />
                                                                    <Setter Property="BorderBrush" Value="#A7F3D0" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="{x:Static core:DeviceConnectionStatus.Listening}">
                                                                    <Setter Property="Background" Value="#D1FAE5" />
                                                                    <Setter Property="BorderBrush" Value="#A7F3D0" />
                                                                </DataTrigger>
                                                                <!-- Error -->
                                                                <DataTrigger Binding="{Binding Status}" Value="{x:Static core:DeviceConnectionStatus.Error}">
                                                                    <Setter Property="Background" Value="#FEE2E2" />
                                                                    <Setter Property="BorderBrush" Value="#FCA5A5" />
                                                                </DataTrigger>
                                                                <!-- Disconnected -->
                                                                <DataTrigger Binding="{Binding Status}" Value="{x:Static core:DeviceConnectionStatus.Disconnected}">
                                                                    <Setter Property="Background" Value="#F1F5F9" />
                                                                    <Setter Property="BorderBrush" Value="#E2E8F0" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <!-- Default state (Warning) -->
                                                                <Setter Property="Foreground" Value="#B45309" />
                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                                <Setter Property="FontSize" Value="11" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static core:DeviceConnectionStatus.Connected}">
                                                                        <Setter Property="Foreground" Value="#047857" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static core:DeviceConnectionStatus.Listening}">
                                                                        <Setter Property="Foreground" Value="#047857" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static core:DeviceConnectionStatus.Error}">
                                                                        <Setter Property="Foreground" Value="#B91C1C" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static core:DeviceConnectionStatus.Disconnected}">
                                                                        <Setter Property="Foreground" Value="#475569" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Device" Binding="{Binding Name}" Width="170" />
                                    <DataGridTextColumn Header="Type" Binding="{Binding TypeText}" Width="90" />
                                    <DataGridTextColumn Header="Protocol" Binding="{Binding ProtocolText}" Width="90" />
                                    <DataGridTextColumn Header="Endpoint" Binding="{Binding Endpoint}" Width="180" />
                                    <DataGridTextColumn Header="Mode" Binding="{Binding ModeText}" Width="80" />
                                    <DataGridTextColumn Header="Received" Binding="{Binding ReceivedCount}" Width="82" ElementStyle="{StaticResource RightAlignedCellText}" />
                                    <DataGridTextColumn Header="Out Q" Binding="{Binding OutputQueuedCount}" Width="70" CellStyle="{StaticResource OutputQueueDashboardCell}" ElementStyle="{StaticResource RightAlignedCellText}" />
                                    <DataGridTextColumn Header="Order Q" Binding="{Binding OrderQueuedCount}" Width="72" CellStyle="{StaticResource OrderQueueDashboardCell}" ElementStyle="{StaticResource RightAlignedCellText}" />
                                    <DataGridTextColumn Header="Sent" Binding="{Binding SentCount}" Width="68" ElementStyle="{StaticResource RightAlignedCellText}" />
                                    <DataGridTextColumn Header="Errored" Binding="{Binding ErroredCount}" Width="72" CellStyle="{StaticResource ErroredDashboardCell}" ElementStyle="{StaticResource RightAlignedCellText}" />
                                    <DataGridTextColumn Header="Last Message" Binding="{Binding LastMessageText}" Width="138" />
                                    <DataGridTextColumn Header="Connection" Binding="{Binding ConnectionText}" Width="90" />
                                    <DataGridTextColumn Header="Last Error" Binding="{Binding LastError}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </GroupBox>

                        <GroupBox Grid.Row="2" Header="Log Information">
                            <TextBox x:Name="DashboardLogTextBox"
                                     Style="{StaticResource LogDetailTextBox}"
                                     TextWrapping="NoWrap"
                                     MinHeight="96" />
                        </GroupBox>
                    </Grid>
                </TabItem>

                <TabItem Header="Device Config">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="38" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <DataGrid x:Name="DevicesGrid"
                                  Grid.Row="0"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  SelectionMode="Single"
                                  SelectionChanged="DevicesGrid_SelectionChanged"
                                  HeadersVisibility="Column"
                                  MinHeight="78"
                                  MaxHeight="112"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Status" Width="95">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="10" Padding="6,2" HorizontalAlignment="Center" VerticalAlignment="Center" BorderThickness="1">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <!-- Default Warning -->
                                                        <Setter Property="Background" Value="#FEF3C7" />
                                                        <Setter Property="BorderBrush" Value="#FDE68A" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static core:DeviceConnectionStatus.Connected}">
                                                                <Setter Property="Background" Value="#D1FAE5" />
                                                                <Setter Property="BorderBrush" Value="#A7F3D0" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static core:DeviceConnectionStatus.Listening}">
                                                                <Setter Property="Background" Value="#D1FAE5" />
                                                                <Setter Property="BorderBrush" Value="#A7F3D0" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static core:DeviceConnectionStatus.Error}">
                                                                <Setter Property="Background" Value="#FEE2E2" />
                                                                <Setter Property="BorderBrush" Value="#FCA5A5" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static core:DeviceConnectionStatus.Disconnected}">
                                                                <Setter Property="Background" Value="#F1F5F9" />
                                                                <Setter Property="BorderBrush" Value="#E2E8F0" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <!-- Default Warning -->
                                                            <Setter Property="Foreground" Value="#B45309" />
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                            <Setter Property="FontSize" Value="10" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="{x:Static core:DeviceConnectionStatus.Connected}">
                                                                    <Setter Property="Foreground" Value="#047857" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="{x:Static core:DeviceConnectionStatus.Listening}">
                                                                    <Setter Property="Foreground" Value="#047857" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="{x:Static core:DeviceConnectionStatus.Error}">
                                                                    <Setter Property="Foreground" Value="#B91C1C" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="{x:Static core:DeviceConnectionStatus.Disconnected}">
                                                                    <Setter Property="Foreground" Value="#475569" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Device" Binding="{Binding Name}" Width="160" />
                                <DataGridTextColumn Header="Type" Binding="{Binding TypeText}" Width="100" />
                                <DataGridTextColumn Header="Transformer" Binding="{Binding TransformerText}" Width="130" />
                                <DataGridTextColumn Header="IP" Binding="{Binding IpText}" Width="120" />
                                <DataGridTextColumn Header="Port" Binding="{Binding PortText}" Width="80" />
                                <DataGridTextColumn Header="Mode" Binding="{Binding ModeText}" Width="80" />
                                <DataGridTextColumn Header="Directory" Binding="{Binding OutputTarget}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <Border Grid.Row="1"
                                Margin="0,6,0,2"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="0,1,0,1"
                                Padding="0,4">
                            <WrapPanel Orientation="Horizontal">
                                <Button x:Name="NewFromPresetButton" Margin="0,2,6,2" Content="New From Preset" Click="AddProfilePresetDevice_Click" />
                                <Button x:Name="NewTcpButton" Margin="0,2,6,2" Content="New TCP Draft" Click="AddTcpDevice_Click" />
                                <Button x:Name="NewSerialButton" Margin="0,2,14,2" Content="New Serial Draft" Click="AddSerialDevice_Click" />
                                <Button x:Name="ConnectSelectedButton" Margin="0,2,6,2" Content="Connect" Click="ConnectSelected_Click" />
                                <Button x:Name="DisconnectSelectedButton" Margin="0,2,14,2" Content="Disconnect" Click="DisconnectSelected_Click" />
                                <Button x:Name="ModifyConfigButton" Margin="0,2,6,2" Content="Modify" Click="Modify_Click" />
                                <Button x:Name="DeleteDeviceButton" Margin="0,2,14,2" Content="Delete" Click="DeleteDevice_Click" />
                                <Button x:Name="SaveConfigButton" Margin="0,2,6,2" Content="Save" Click="SaveConfig_Click" />
                                <Button x:Name="CancelConfigButton" Margin="0,2,14,2" Content="Cancel" Click="CancelConfig_Click" />
                                <Button Margin="0,2,6,2" Content="Load Defaults" IsEnabled="False" />
                            </WrapPanel>
                        </Border>

                        <ScrollViewer Grid.Row="2"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto">
                            <Grid MinWidth="1040">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="300" />
                                    <ColumnDefinition Width="*" MinWidth="620" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <GroupBox Grid.Row="0" Grid.Column="0" Header="Device Card" Margin="0,2,10,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="92" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="30" />
                                            <RowDefinition Height="30" />
                                            <RowDefinition Height="30" />
                                            <RowDefinition Height="30" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="Name" />
                                        <TextBox x:Name="DeviceNameTextBox" Grid.Row="0" Grid.Column="1" />
                                        <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="Use" />
                                        <CheckBox x:Name="EnabledCheckBox" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Content="Enabled" />
                                        <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="Startup" />
                                        <CheckBox x:Name="AutoConnectCheckBox" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" Content="Auto connect" />
                                        <TextBlock Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Text="Probe" />
                                        <CheckBox x:Name="ProbeEnabledCheckBox" Grid.Row="3" Grid.Column="1" VerticalAlignment="Center" Content="Diagnostic mode" />
                                    </Grid>
                                </GroupBox>

                                <GroupBox Grid.Row="1" Grid.Column="0" Header="Profile / Connection Branch" Margin="0,2,10,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="92" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="30" />
                                            <RowDefinition Height="30" />
                                            <RowDefinition Height="30" />
                                            <RowDefinition Height="30" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="Preset" />
                                        <ComboBox x:Name="ProfilePresetComboBox"
                                                  Grid.Row="0"
                                                  Grid.Column="1"
                                                  ToolTip="Preset only creates a starting profile. Exact analyzer behavior still belongs in Device Communication Profile files." />
                                        <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="Transport" />
                                        <ComboBox x:Name="TransportComboBox"
                                                  Grid.Row="1"
                                                  Grid.Column="1"
                                                  SelectionChanged="TransportComboBox_SelectionChanged" />
                                        <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="Protocol" />
                                        <ComboBox x:Name="ProtocolComboBox"
                                                  Grid.Row="2"
                                                  Grid.Column="1"
                                                  SelectionChanged="ProtocolComboBox_SelectionChanged" />
                                        <TextBlock Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Text="Write log" />
                                        <CheckBox Grid.Row="3" Grid.Column="1" VerticalAlignment="Center" IsChecked="True" IsEnabled="False" Content="Enabled" />
                                    </Grid>
                                </GroupBox>

                                <GroupBox Grid.Row="2" Grid.Column="0" Header="Output" Margin="0,2,10,0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="30" />
                                            <RowDefinition Height="30" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="70" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="Type" />
                                            <ComboBox x:Name="OutputTypeComboBox" Grid.Column="1" />
                                        </Grid>
                                        <TextBox x:Name="OutputUrlTextBox" Grid.Row="1" />
                                        <TextBlock x:Name="ValidationTextBlock"
                                                   Grid.Row="2"
                                                   Margin="0,8,0,0"
                                                   TextWrapping="Wrap"
                                                   Foreground="#8a4b00" />
                                    </Grid>
                                </GroupBox>

                                <Grid Grid.Row="0" Grid.Column="1" Margin="0,0,10,6">
                                    <GroupBox x:Name="TcpSettingsPanel" Header="TCP Settings">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="220" />
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="120" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="30" />
                                                <RowDefinition Height="30" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="Host/IP" />
                                            <TextBox x:Name="HostTextBox" Grid.Row="0" Grid.Column="1" />
                                            <TextBlock Grid.Row="0" Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center" Text="Port" />
                                            <TextBox x:Name="PortTextBox" Grid.Row="0" Grid.Column="3" />
                                            <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="Role" />
                                            <TextBlock x:Name="TcpRoleTextBlock" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" VerticalAlignment="Center" />
                                        </Grid>
                                    </GroupBox>

                                    <GroupBox x:Name="SerialSettingsPanel" Header="Serial COM Settings">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="130" />
                                                <ColumnDefinition Width="Auto" MinWidth="105" />
                                                <ColumnDefinition Width="130" />
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="30" />
                                                <RowDefinition Height="30" />
                                                <RowDefinition Height="30" />
                                                <RowDefinition Height="30" />
                                                <RowDefinition Height="30" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="COM Port" />
                                            <TextBox x:Name="ComPortTextBox" Grid.Row="0" Grid.Column="1" />
                                            <TextBlock Grid.Row="0" Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center" Text="Baud" />
                                            <TextBox x:Name="BaudRateTextBox" Grid.Row="0" Grid.Column="3" Text="9600" />
                                            <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="Data Bits" />
                                            <TextBox x:Name="DataBitsTextBox" Grid.Row="1" Grid.Column="1" Text="8" />
                                            <TextBlock Grid.Row="1" Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center" Text="Stop Bits" />
                                            <ComboBox x:Name="StopBitsComboBox" Grid.Row="1" Grid.Column="3" />
                                            <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="Parity" />
                                            <ComboBox x:Name="ParityComboBox" Grid.Row="2" Grid.Column="1" />
                                            <TextBlock Grid.Row="2" Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center" Text="Flow" />
                                            <ComboBox x:Name="FlowControlComboBox" Grid.Row="2" Grid.Column="3" />
                                            <TextBlock Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Text="Read ms" />
                                            <TextBox x:Name="ReadTimeoutTextBox" Grid.Row="3" Grid.Column="1" Text="200" />
                                            <TextBlock Grid.Row="3" Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center" Text="Write ms" />
                                            <TextBox x:Name="WriteTimeoutTextBox" Grid.Row="3" Grid.Column="3" Text="2000" />
                                            <TextBlock Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Text="Coalesce" />
                                            <TextBox x:Name="ReadCoalesceTextBox" Grid.Row="4" Grid.Column="1" Text="15" />
                                            <TextBlock Grid.Row="4" Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center" Text="Max buffer" />
                                            <TextBox x:Name="MaxBufferTextBox" Grid.Row="4" Grid.Column="3" Text="1048576" />
                                        </Grid>
                                    </GroupBox>

                                    <GroupBox x:Name="FolderSettingsPanel" Header="Folder Watch Settings">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="30" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="Folder" />
                                            <TextBox x:Name="FolderTextBox" Grid.Column="1" />
                                        </Grid>
                                    </GroupBox>
                                </Grid>

                                <GroupBox Grid.Row="1" Grid.Column="1" Header="Protocol Branch" Margin="0,2,10,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="190" />
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="30" />
                                                <RowDefinition Height="30" />
                                                <RowDefinition Height="30" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="Boundary" />
                                            <TextBlock x:Name="FramingModeTextBlock" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" />
                                            <TextBlock Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" Text="Handshake" />
                                            <TextBlock x:Name="HandshakeTextBlock" Grid.Row="0" Grid.Column="3" VerticalAlignment="Center" />

                                            <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="Start / End" />
                                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                                                <TextBox x:Name="FrameStartTextBox" Width="75" Text="&lt;STX&gt;" IsEnabled="False" />
                                                <TextBlock Margin="6,0" VerticalAlignment="Center" Text="to" />
                                                <TextBox x:Name="FrameEndTextBox" Width="85" Text="&lt;ETX/ETB&gt;" IsEnabled="False" />
                                            </StackPanel>
                                            <TextBlock Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" Text="Checksum" />
                                            <TextBlock x:Name="ChecksumTextBlock" Grid.Row="1" Grid.Column="3" VerticalAlignment="Center" />

                                            <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="Direction" />
                                            <TextBlock x:Name="DirectionTextBlock" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" />
                                        </Grid>

                                         <Grid x:Name="AstmPolicyGrid" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2">
                                             <Grid.RowDefinitions>
                                                 <RowDefinition Height="Auto" />
                                                 <RowDefinition Height="Auto" />
                                             </Grid.RowDefinitions>

                                             <GroupBox Grid.Row="0" Header="ASTM Session Policy" Margin="0,2,0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="110" />
                                                        <ColumnDefinition Width="170" />
                                                        <ColumnDefinition Width="120" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="28" />
                                                        <RowDefinition Height="28" />
                                                        <RowDefinition Height="28" />
                                                        <RowDefinition Height="28" />
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="Direction" />
                                                    <ComboBox x:Name="AstmDirectionComboBox" Grid.Row="0" Grid.Column="1" />
                                                    <TextBlock Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" Text="Checksum" />
                                                    <ComboBox x:Name="AstmChecksumModeComboBox" Grid.Row="0" Grid.Column="3" />
                                                    <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="Frame number" />
                                                    <ComboBox x:Name="AstmFrameNumberModeComboBox" Grid.Row="1" Grid.Column="1" />
                                                    <TextBlock Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" Text="Duplicate" />
                                                    <ComboBox x:Name="AstmDuplicateFramePolicyComboBox" Grid.Row="1" Grid.Column="3" />
                                                    <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="ENQ collision" />
                                                    <ComboBox x:Name="AstmEnqCollisionPolicyComboBox" Grid.Row="2" Grid.Column="1" />
                                                    <StackPanel Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2" Orientation="Horizontal">
                                                        <CheckBox x:Name="AstmAckEnqCheckBox" Margin="0,0,10,0" VerticalAlignment="Center" Content="ACK ENQ" />
                                                        <CheckBox x:Name="AstmAckFrameCheckBox" Margin="0,0,10,0" VerticalAlignment="Center" Content="ACK frame" />
                                                        <CheckBox x:Name="AstmNakChecksumCheckBox" VerticalAlignment="Center" Content="NAK checksum" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Text="ACK timeout" />
                                                    <TextBox x:Name="AstmAckTimeoutTextBox" Grid.Row="3" Grid.Column="1" Text="3000" />
                                                    <TextBlock Grid.Row="3" Grid.Column="2" VerticalAlignment="Center" Text="Retries / gap" />
                                                    <StackPanel Grid.Row="3" Grid.Column="3" Orientation="Horizontal">
                                                        <TextBox x:Name="AstmMaxRetriesTextBox" Width="48" Text="3" />
                                                        <TextBlock Margin="6,0" VerticalAlignment="Center" Text="/" />
                                                        <TextBox x:Name="AstmInterFrameTimeoutTextBox" Width="70" Text="5000" />
                                                        <CheckBox x:Name="AstmEndOnEotCheckBox" Margin="10,0,0,0" VerticalAlignment="Center" Content="EOT ends" />
                                                    </StackPanel>
                                                </Grid>
                                             </GroupBox>

                                             <GroupBox Grid.Row="1" Header="ASTM Limits / Order Reply" Margin="0,2,0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="120" />
                                                        <ColumnDefinition Width="120" />
                                                        <ColumnDefinition Width="110" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="28" />
                                                        <RowDefinition Height="28" />
                                                        <RowDefinition Height="28" />
                                                        <RowDefinition Height="28" />
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="Max bytes" />
                                                    <TextBox x:Name="AstmMaxTransactionBytesTextBox" Grid.Row="0" Grid.Column="1" Text="1048576" />
                                                    <TextBlock Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" Text="Max frames" />
                                                    <TextBox x:Name="AstmMaxFrameCountTextBox" Grid.Row="0" Grid.Column="3" Text="256" />
                                                    <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="TX frame bytes" />
                                                    <TextBox x:Name="AstmMaxOutboundPayloadTextBox" Grid.Row="1" Grid.Column="1" Text="240" />
                                                    <CheckBox x:Name="AstmOrderReplyEnabledCheckBox"
                                                              Grid.Row="1"
                                                              Grid.Column="2"
                                                              Grid.ColumnSpan="2"
                                                              VerticalAlignment="Center"
                                                              Content="Enable prepared-order reply"
                                                              Checked="AstmOrderReplyEnabledCheckBox_Changed"
                                                              Unchecked="AstmOrderReplyEnabledCheckBox_Changed" />
                                                    <CheckBox x:Name="AstmAutoReplyCheckBox" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" VerticalAlignment="Center" Content="Auto reply matched Q query" />
                                                    <TextBlock Grid.Row="2" Grid.Column="2" VerticalAlignment="Center" Text="Unknown Q" />
                                                    <ComboBox x:Name="AstmUnknownQueryPolicyComboBox" Grid.Row="2" Grid.Column="3" />
                                                    <TextBlock Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Text="Host name" />
                                                    <TextBox x:Name="AstmOrderHostTextBox" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Text="EdgeGateway" />
                                                </Grid>
                                            </GroupBox>
                                        </Grid>

                                        <GroupBox x:Name="RawBoundaryGrid" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Header="Raw / Text Boundary" Margin="0,2,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="110" />
                                                    <ColumnDefinition Width="170" />
                                                    <ColumnDefinition Width="110" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="28" />
                                                    <RowDefinition Height="28" />
                                                    <RowDefinition Height="28" />
                                                    <RowDefinition Height="28" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="Mode" />
                                                <ComboBox x:Name="RawBoundaryModeComboBox"
                                                          Grid.Row="0"
                                                          Grid.Column="1"
                                                          SelectionChanged="RawBoundaryModeComboBox_SelectionChanged" />
                                                <TextBlock Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" Text="Delimiter" />
                                                <ComboBox x:Name="RawDelimiterComboBox" Grid.Row="0" Grid.Column="3" />
                                                <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="Custom delim" />
                                                <TextBox x:Name="RawCustomDelimiterTextBox" Grid.Row="1" Grid.Column="1" ToolTip="Use tokens such as &lt;CR&gt;, &lt;LF&gt;, &lt;CRLF&gt;, or hex:02 03." />
                                                <TextBlock Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" Text="Fixed length" />
                                                <TextBox x:Name="RawFixedLengthTextBox" Grid.Row="1" Grid.Column="3" />
                                                <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="Start bytes" />
                                                <TextBox x:Name="RawStartBytesTextBox" Grid.Row="2" Grid.Column="1" ToolTip="Example: &lt;STX&gt; or hex:02." />
                                                <TextBlock Grid.Row="2" Grid.Column="2" VerticalAlignment="Center" Text="End bytes" />
                                                <TextBox x:Name="RawEndBytesTextBox" Grid.Row="2" Grid.Column="3" ToolTip="Example: &lt;ETX&gt;&lt;CR&gt;&lt;LF&gt; or hex:03 0D 0A." />
                                                <TextBlock Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Text="Max bytes" />
                                                <TextBox x:Name="RawMaxMessageBytesTextBox" Grid.Row="3" Grid.Column="1" Text="65536" />
                                                <CheckBox x:Name="RawIncludeBoundaryCheckBox" Grid.Row="3" Grid.Column="2" Grid.ColumnSpan="2" VerticalAlignment="Center" Content="Keep start/end bytes in captured message" />
                                            </Grid>
                                        </GroupBox>

                                        <GroupBox x:Name="MllpPolicyGrid" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Header="HL7 MLLP Boundary" Margin="0,2,0,6">
                                            <TextBlock TextWrapping="Wrap"
                                                       Text="MLLP uses &lt;VT&gt; message &lt;FS&gt;&lt;CR&gt;. HL7 ACK builder is intentionally kept in protocol profile work; this Manager view does not expose clinical mapping." />
                                        </GroupBox>

                                        <TextBlock Grid.Row="2"
                                                   Grid.Column="0"
                                                   Grid.ColumnSpan="2"
                                                   Margin="4,8,4,0"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   TextWrapping="Wrap"
                                                   Text="Advanced parser/template rules stay in Device Communication Profiles built from each analyzer communication manual. This screen edits safe transport/session fields only." />
                                    </Grid>
                                </GroupBox>

                                <GroupBox Grid.Row="2" Grid.Column="1" Header="Current Branch" Margin="0,2,10,0">
                                    <TextBlock x:Name="SelectedBranchTextBlock"
                                               Margin="2"
                                               TextWrapping="Wrap" />
                                </GroupBox>

                            </Grid>
                        </ScrollViewer>
                    </Grid>
                </TabItem>

                <TabItem Header="Logs">
                    <TabControl Margin="10">
                        <TabItem Header="Communication">
                            <Grid Margin="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="38" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <WrapPanel Grid.Row="0" VerticalAlignment="Center">
                                     <TextBlock VerticalAlignment="Center" Margin="0,2,8,2" Text="Log type" />
                                     <ComboBox x:Name="LogCategoryComboBox"
                                               Width="150"
                                               Margin="0,2,14,2"
                                               SelectionChanged="LogCategoryComboBox_SelectionChanged" />
                                     <TextBlock VerticalAlignment="Center" Margin="0,2,8,2" Text="Level" />
                                     <ComboBox x:Name="LogLevelComboBox"
                                               Width="110"
                                               Margin="0,2,14,2"
                                               SelectionChanged="LogLevelComboBox_SelectionChanged" />
                                     <TextBlock VerticalAlignment="Center" Margin="0,2,8,2" Text="Limit" />
                                     <TextBox x:Name="LogLimitTextBox"
                                              Width="58"
                                              Margin="0,2,14,2"
                                              Text="500"
                                              HorizontalContentAlignment="Right" />
                                     <Button Margin="0,2,8,2" Content="Select All" Click="SelectAllDeviceLogs_Click" />
                                     <Button Margin="0,2,0,2" Content="Clear View" Click="DeleteSelectedDeviceLogs_Click" />
                                </WrapPanel>
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="250" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <GroupBox Header="Log File" Padding="4">
                                        <ListBox x:Name="DeviceLogFilesListBox"
                                                 SelectionMode="Extended"
                                                 SelectionChanged="DeviceLogFilesListBox_SelectionChanged" />
                                    </GroupBox>
                                    <TextBox x:Name="DeviceLogDetailsTextBox"
                                             Grid.Column="2"
                                             Style="{StaticResource LogDetailTextBox}"
                                             TextWrapping="NoWrap"
                                             VerticalContentAlignment="Top" />
                                </Grid>
                            </Grid>
                        </TabItem>

                        <TabItem Header="Exceptions">
                            <Grid Margin="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="38" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <WrapPanel Grid.Row="0" VerticalAlignment="Center">
                                     <Button Margin="0,2,8,2" Content="Select All" Click="SelectAllExceptions_Click" />
                                     <Button Margin="0,2,0,2" Content="Clear View" Click="DeleteSelectedExceptions_Click" />
                                </WrapPanel>
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <GroupBox Header="Exception File" Padding="4">
                                        <ListBox x:Name="ExceptionFilesListBox"
                                                 SelectionMode="Extended"
                                                 SelectionChanged="ExceptionFilesListBox_SelectionChanged" />
                                    </GroupBox>
                                    <TextBox x:Name="ExceptionDetailsTextBox"
                                             Grid.Column="2"
                                             Style="{StaticResource LogDetailTextBox}"
                                             TextWrapping="NoWrap"
                                             VerticalContentAlignment="Top" />
                                </Grid>
                            </Grid>
                        </TabItem>

                        <TabItem Header="Output Queue">
                            <Grid Margin="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="38" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <WrapPanel Grid.Row="0" VerticalAlignment="Center">
                                     <TextBlock VerticalAlignment="Center" Margin="0,2,8,2" Text="Status" />
                                     <ComboBox x:Name="OutputStatusFilterComboBox"
                                               Width="130"
                                               Margin="0,2,14,2"
                                               SelectionChanged="OutputStatusFilterComboBox_SelectionChanged" />
                                     <TextBlock VerticalAlignment="Center" Margin="0,2,8,2" Text="Limit" />
                                     <TextBox x:Name="OutputLimitTextBox"
                                              Width="58"
                                              Margin="0,2,14,2"
                                              Text="500"
                                              HorizontalContentAlignment="Right" />
                                     <Button Margin="0,2,8,2" Content="Refresh" Click="RefreshOutputQueue_Click" />
                                     <Button x:Name="ReplaySelectedOutputButton"
                                             Margin="0,2,8,2"
                                             Content="Replay Selected"
                                             Click="ReplaySelectedOutput_Click" />
                                     <Button x:Name="ReplayAllFailedOutputButton"
                                             Margin="0,2,0,2"
                                             Content="Replay All Failed"
                                             Click="ReplayAllFailedOutput_Click" />
                                </WrapPanel>
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="420" />
                                    </Grid.ColumnDefinitions>
                                    <DataGrid x:Name="OutputQueueGrid"
                                              AutoGenerateColumns="False"
                                              IsReadOnly="True"
                                              SelectionMode="Single"
                                              SelectionChanged="OutputQueueGrid_SelectionChanged">
                                        <DataGrid.Columns>
                                             <DataGridTextColumn Header="Updated" Binding="{Binding UpdatedText}" Width="Auto" MinWidth="130" />
                                            <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="96" />
                                            <DataGridTextColumn Header="Device" Binding="{Binding DeviceId}" Width="140" />
                                            <DataGridTextColumn Header="Raw Id" Binding="{Binding RawId}" Width="145" />
                                            <DataGridTextColumn Header="Attempts" Binding="{Binding AttemptCount}" Width="78" />
                                            <DataGridTextColumn Header="Target" Binding="{Binding TargetText}" Width="*" />
                                            <DataGridTextColumn Header="Last Error" Binding="{Binding LastError}" Width="180" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <TextBox x:Name="OutputQueueDetailsTextBox"
                                             Grid.Column="2"
                                             Style="{StaticResource LogDetailTextBox}"
                                             TextWrapping="Wrap"
                                             VerticalContentAlignment="Top" />
                                </Grid>
                            </Grid>
                        </TabItem>

                        <TabItem Header="Orders">
                            <Grid Margin="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="340" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="38" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <WrapPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">
                                     <Button Margin="0,2,8,2" Content="Refresh" Click="RefreshOrders_Click" />
                                     <Button x:Name="NewOrderButton" Margin="0,2,8,2" Content="New" Click="NewOrder_Click" />
                                     <TextBlock VerticalAlignment="Center" Margin="0,2,0,2" Text="Prepared mock orders only; no LIS lookup in this slice." Foreground="{StaticResource TextMutedBrush}" />
                                </WrapPanel>
                                <DataGrid x:Name="OrdersGrid"
                                          Grid.Row="1"
                                          Grid.Column="0"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          SelectionMode="Single"
                                          SelectionChanged="OrdersGrid_SelectionChanged">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Sample" Binding="{Binding SampleKey}" Width="150" />
                                        <DataGridTextColumn Header="Tests" Binding="{Binding TestCodesText}" Width="160" />
                                        <DataGridCheckBoxColumn Header="On" Binding="{Binding Enabled}" Width="56" />
                                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="95" />
                                        <DataGridTextColumn Header="Last Sent" Binding="{Binding LastSentText}" Width="145" />
                                        <DataGridTextColumn Header="Last Error" Binding="{Binding LastError}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <GroupBox Grid.Row="1" Grid.Column="2" Header="Prepared Order Editor" Padding="10">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="30" />
                                            <RowDefinition Height="30" />
                                            <RowDefinition Height="30" />
                                            <RowDefinition Height="30" />
                                            <RowDefinition Height="12" />
                                            <RowDefinition Height="30" />
                                            <RowDefinition Height="30" />
                                            <RowDefinition Height="30" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="Sample key" />
                                        <TextBox x:Name="OrderSampleKeyTextBox" Grid.Row="0" Grid.Column="1" />
                                        <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="Test codes" />
                                        <TextBox x:Name="OrderTestCodesTextBox" Grid.Row="1" Grid.Column="1" ToolTip="Comma separated test codes." />
                                        <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="Enabled" />
                                        <CheckBox x:Name="OrderEnabledCheckBox" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" IsChecked="True" />
                                        <TextBlock Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Text="Status" />
                                        <TextBlock x:Name="OrderStatusTextBlock" Grid.Row="3" Grid.Column="1" VerticalAlignment="Center" />
                                         <Button x:Name="SaveOrderButton" Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" VerticalAlignment="Center" Content="Save" Click="SaveOrder_Click" />
                                         <Button x:Name="ReplyOrderButton" Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,4,0,0" VerticalAlignment="Center" Content="Reply Now" Click="ReplyOrderNow_Click" />
                                         <Button x:Name="DeleteOrderButton" Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,4,0,0" VerticalAlignment="Center" Content="Delete" Click="DeleteOrder_Click" />
                                    </Grid>
                                </GroupBox>
                            </Grid>
                        </TabItem>

                        <TabItem Header="Packets">
                            <Grid Margin="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="38" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <WrapPanel Grid.Row="0" VerticalAlignment="Center">
                                     <TextBlock VerticalAlignment="Center" Margin="0,2,8,2" Text="Direction" />
                                     <ComboBox x:Name="PacketDirectionComboBox"
                                               Width="100"
                                               Margin="0,2,14,2"
                                               SelectionChanged="PacketDirectionComboBox_SelectionChanged" />
                                     <TextBlock VerticalAlignment="Center" Margin="0,2,8,2" Text="Limit" />
                                     <TextBox x:Name="PacketLimitTextBox"
                                              Width="58"
                                              Margin="0,2,14,2"
                                              Text="500"
                                              HorizontalContentAlignment="Right" />
                                     <Button Margin="0,2,0,2" Content="Refresh" Click="RefreshPackets_Click" />
                                </WrapPanel>
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="420" />
                                    </Grid.ColumnDefinitions>
                                    <DataGrid x:Name="PacketLogGrid"
                                              AutoGenerateColumns="False"
                                              IsReadOnly="True"
                                              SelectionMode="Single"
                                              SelectionChanged="PacketLogGrid_SelectionChanged">
                                        <DataGrid.Columns>
                                             <DataGridTextColumn Header="Time" Binding="{Binding TimestampText}" Width="Auto" MinWidth="110" />
                                            <DataGridTextColumn Header="Dir" Binding="{Binding Direction}" Width="58" />
                                            <DataGridTextColumn Header="Control" Binding="{Binding ControlType}" Width="88" />
                                            <DataGridTextColumn Header="Bytes" Binding="{Binding ByteCount}" Width="70" />
                                            <DataGridTextColumn Header="Summary" Binding="{Binding ParsedSummary}" Width="*" />
                                            <DataGridTextColumn Header="Error" Binding="{Binding Error}" Width="160" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <TextBox x:Name="PacketLogDetailsTextBox"
                                             Grid.Column="2"
                                             Style="{StaticResource LogDetailTextBox}"
                                             TextWrapping="Wrap"
                                             VerticalContentAlignment="Top" />
                                </Grid>
                            </Grid>
                        </TabItem>

                        <TabItem Header="Captured Files">
                            <Grid Margin="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="38" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <WrapPanel Grid.Row="0" VerticalAlignment="Center">
                                     <Button Margin="0,2,8,2" Content="Select All" Click="SelectAllCapturedFiles_Click" />
                                     <Button x:Name="HideCapturedFilesButton" Margin="0,2,0,2" Content="Hide Selected" Click="DeleteSelectedCapturedFiles_Click" />
                                </WrapPanel>
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="260" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <GroupBox Header="Captured File" Padding="4">
                                        <ListBox x:Name="CapturedFilesListBox"
                                                 SelectionMode="Extended"
                                                 SelectionChanged="CapturedFilesListBox_SelectionChanged" />
                                    </GroupBox>
                                    <TextBox x:Name="CapturedFileDetailsTextBox"
                                             Grid.Column="2"
                                             Style="{StaticResource LogDetailTextBox}"
                                             TextWrapping="NoWrap"
                                             VerticalContentAlignment="Top" />
                                </Grid>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </TabItem>
            </TabControl>
        </Grid>
    </DockPanel>
</Window>
