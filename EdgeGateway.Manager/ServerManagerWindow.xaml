<Window x:Class="EdgeGateway.Manager.ServerManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EdgeGateway Server Manager"
        Icon="logo.png"
        Width="600"
        Height="460"
        MinWidth="600"
        MinHeight="460"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        FontFamily="Segoe UI"
        FontSize="11.5"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <Style x:Key="LabelText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="11.5" />
        </Style>
    </Window.Resources>

    <DockPanel Background="{StaticResource BackgroundBrush}">
        <!-- Modern Header -->
        <Border DockPanel.Dock="Top"
                Height="48"
                Background="{StaticResource HeaderBackgroundBrush}"
                Padding="16,0"
                BorderBrush="{StaticResource HeaderBorderBrush}"
                BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="app-logo-alt.png" Width="24" Height="24" Margin="0,0,10,0" SnapsToDevicePixels="True" />
                <TextBlock Text="EdgeGateway Server Manager"
                           Foreground="White"
                           FontSize="15"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- Modern Footer -->
        <Border DockPanel.Dock="Bottom"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,12"
                Background="{StaticResource CardBackgroundBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="FooterStatusTextBlock"
                           Grid.Column="0"
                           Margin="0,0,12,0"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextMutedBrush}"
                           FontWeight="Medium"
                           TextTrimming="CharacterEllipsis"
                           Text="Ready" />
                <Button x:Name="ApplyButton"
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        Content="Apply"
                        Style="{StaticResource PrimaryButton}"
                        Click="ApplyServerSettings_Click" />
                <Button Grid.Column="2" Margin="8,0,0,0" Content="Close" Click="Close_Click" />
            </Grid>
        </Border>

        <Grid Margin="16,12,16,12">
            <TabControl>
                <TabItem Header="Service">
                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Background="{StaticResource CardBackgroundBrush}" CornerRadius="0,0,6,6" Padding="20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="20" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <WrapPanel Grid.Row="0" VerticalAlignment="Center">
                                <Button x:Name="StartServiceButton" Margin="0,0,8,0" Content="Start" Style="{StaticResource SuccessButton}" Click="StartWindowsService_Click" />
                                <Button x:Name="RestartServiceButton" Margin="0,0,8,0" Content="Restart" Style="{StaticResource PrimaryButton}" Click="RestartWindowsService_Click" />
                                <Button x:Name="StopServiceButton" Margin="0,0,8,0" Content="Stop" Style="{StaticResource DangerButton}" Click="StopWindowsService_Click" />
                                <Button Margin="0,0,8,0" Content="Refresh" Click="Refresh_Click" />
                                <Button Margin="8,0,0,0" Content="Device Manager" Click="OpenDeviceManager_Click" />
                            </WrapPanel>

                            <!-- Horizontal divider -->
                            <Border Grid.Row="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Margin="0,0,0,10" VerticalAlignment="Center" />

                            <Grid Grid.Row="2" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource LabelText}" Text="Service Name" />
                                <TextBlock x:Name="ServiceNameTextBlock" Grid.Column="1" VerticalAlignment="Center" Foreground="{StaticResource TextDarkBrush}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            </Grid>

                            <Grid Grid.Row="3" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource LabelText}" Text="Status" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border CornerRadius="12" BorderThickness="1.5" Padding="10,3" VerticalAlignment="Center" Background="#F1F5F9">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BorderBrush" Value="{Binding Foreground, ElementName=WindowsServiceStatusTextBlock}" />
                                            </Style>
                                        </Border.Style>
                                        <TextBlock x:Name="WindowsServiceStatusTextBlock"
                                                   VerticalAlignment="Center"
                                                   FontWeight="Bold" />
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Row="4" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource LabelText}" Text="Startup Type" />
                                <TextBlock x:Name="ServiceStartupTypeTextBlock" Grid.Column="1" VerticalAlignment="Center" Foreground="{StaticResource TextDarkBrush}" FontWeight="Medium" />
                            </Grid>
                        </Grid>
                    </Border>
                </TabItem>

                <TabItem Header="Server">
                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Background="{StaticResource CardBackgroundBrush}" CornerRadius="0,0,6,6" Padding="20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="30" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="130" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="20" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- HTTP Port & Main Log Level -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource LabelText}" Text="HTTP Port" />
                            <TextBox x:Name="HttpPortTextBox" Grid.Row="0" Grid.Column="1" HorizontalContentAlignment="Right" />

                            <TextBlock Grid.Row="0" Grid.Column="3" Style="{StaticResource LabelText}" Text="Main Log Level" />
                            <ComboBox x:Name="MainLogLevelComboBox" Grid.Row="0" Grid.Column="4" />

                            <!-- HTTPS Port & Channel Log Level -->
                            <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource LabelText}" Text="HTTPS Port" />
                            <TextBox x:Name="HttpsPortTextBox" Grid.Row="2" Grid.Column="1" HorizontalContentAlignment="Right" />

                            <TextBlock Grid.Row="2" Grid.Column="3" Style="{StaticResource LabelText}" Text="Channel Log Level" />
                            <ComboBox x:Name="ChannelLogLevelComboBox" Grid.Row="2" Grid.Column="4" />

                            <!-- Info Alert Banner -->
                            <Border Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="5" Background="#EFF6FF" BorderBrush="#DBEAFE" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,10,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Path Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z"
                                          Fill="#1D4ED8" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" Stretch="Uniform" />
                                    <TextBlock x:Name="ServerApplyHintTextBlock"
                                               Grid.Column="1"
                                               Foreground="#1E40AF"
                                               FontSize="11"
                                               FontWeight="Medium"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap"
                                               Text="Apply saves ProgramData config. Restart service to apply changes." />
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </TabItem>

                <TabItem Header="Database">
                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Background="{StaticResource CardBackgroundBrush}" CornerRadius="0,0,6,6" Padding="20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="16" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="16" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource LabelText}" Text="DB Type" />
                            <TextBlock x:Name="DatabaseTypeTextBlock" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" Foreground="{StaticResource TextDarkBrush}" FontWeight="SemiBold" Text="SQLite local" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource LabelText}" Text="DB Path" />
                            <TextBox x:Name="DatabasePathTextBox"
                                     Grid.Row="2"
                                     Grid.Column="1"
                                     Grid.ColumnSpan="3"
                                     IsReadOnly="True" />

                            <StackPanel Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Test Connection" Click="TestDatabaseConnection_Click" Margin="0,0,8,0" />
                                <Button Content="Open Folder" Click="OpenDatabaseFolder_Click" />
                            </StackPanel>

                            <!-- Test Result Alert Banner -->
                            <Border Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="4" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,4,0,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="{Binding Foreground, ElementName=DatabaseTestResultTextBlock}" />
                                        <Setter Property="Background" Value="#F8FAFC" />
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Path Data="M12 2C7.58 2 4 3.79 4 6v12c0 2.21 3.58 4 8 4s8-1.79 8-4V6c0-2.21-3.58-4-8-4zm0 2c3.87 0 6 1.43 6 2s-2.13 2-6 2-6-1.43-6-2 2.13-2 6-2zm0 14c-3.87 0-6-1.43-6-2v-2.18c.86.58 2.3 1.01 4.54 1.15.46.03.93.03 1.46.03.53 0 1-.01 1.46-.03 2.24-.14 3.68-.57 4.54-1.15V16c0 .57-2.13 2-6 2zm0-4.82c-3.87 0-6-1.43-6-2v-2.18c.86.58 2.3 1.01 4.54 1.15.46.03.93.03 1.46.03.53 0 1-.01 1.46-.03 2.24-.14 3.68-.57 4.54-1.15V11.18c0 .57-2.13 2-6 2z"
                                          Fill="{Binding Foreground, ElementName=DatabaseTestResultTextBlock}" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" Stretch="Uniform" />
                                    <TextBlock x:Name="DatabaseTestResultTextBlock"
                                               Grid.Column="1"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap"
                                               Text="SQLite is local to this workstation. No server, username, or password is required." />
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </TabItem>

                <TabItem Header="Logs">
                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Background="{StaticResource CardBackgroundBrush}" CornerRadius="0,0,6,6" Padding="20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <DataGrid x:Name="LogFilesListBox"
                                      Grid.Row="0"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      IsReadOnly="True"
                                      SelectionMode="Single"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="File" Binding="{Binding FileName}" Width="*" />
                                    <DataGridTextColumn Header="Modified" Binding="{Binding LastWriteTime}" Width="150" />
                                    <DataGridTextColumn Header="Bytes" Binding="{Binding Length}" Width="90" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Refresh" Click="RefreshLogs_Click" Margin="0,0,8,0" />
                                <Button Content="Open File" Click="ViewLogFile_Click" Margin="0,0,8,0" />
                                <Button Content="Open Folder" Click="OpenLogFolder_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </TabItem>

                <TabItem Header="Info">
                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Background="{StaticResource CardBackgroundBrush}" CornerRadius="0,0,6,6" Padding="20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource LabelText}" Text="Service Version" Margin="0,4,8,8" />
                            <TextBlock x:Name="ServiceVersionTextBlock" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" Foreground="{StaticResource TextDarkBrush}" FontWeight="Medium" Margin="0,4,0,8" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource LabelText}" Text="Manager Version" Margin="0,4,8,8" />
                            <TextBlock x:Name="ManagerVersionTextBlock" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Foreground="{StaticResource TextDarkBrush}" FontWeight="Medium" Margin="0,4,0,8" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource LabelText}" Text="Machine Name" Margin="0,4,8,8" />
                            <TextBlock x:Name="MachineNameTextBlock" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" Foreground="{StaticResource TextDarkBrush}" FontWeight="Medium" Margin="0,4,0,8" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource LabelText}" Text="OS Version" Margin="0,4,8,8" />
                            <TextBlock x:Name="OsVersionTextBlock" Grid.Row="3" Grid.Column="1" VerticalAlignment="Center" Foreground="{StaticResource TextDarkBrush}" FontWeight="Medium" Margin="0,4,0,8" />

                            <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource LabelText}" Text="Runtime Version" Margin="0,4,8,8" />
                            <TextBlock x:Name="RuntimeVersionTextBlock" Grid.Row="4" Grid.Column="1" VerticalAlignment="Center" Foreground="{StaticResource TextDarkBrush}" FontWeight="Medium" Margin="0,4,0,8" />

                            <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource LabelText}" Text="Install Path" Margin="0,4,8,8" />
                            <TextBlock x:Name="InstallPathTextBlock" Grid.Row="5" Grid.Column="1" VerticalAlignment="Center" Foreground="{StaticResource TextDarkBrush}" FontWeight="Medium" TextTrimming="CharacterEllipsis" Margin="0,4,0,8" />

                            <TextBlock Grid.Row="6" Grid.Column="0" Style="{StaticResource LabelText}" Text="Config Path" Margin="0,4,8,8" />
                            <TextBlock x:Name="ConfigPathTextBlock" Grid.Row="6" Grid.Column="1" VerticalAlignment="Center" Foreground="{StaticResource TextDarkBrush}" FontWeight="Medium" TextTrimming="CharacterEllipsis" Margin="0,4,0,8" />

                            <TextBlock Grid.Row="7" Grid.Column="0" Style="{StaticResource LabelText}" Text="Log Path" Margin="0,4,8,8" />
                            <TextBlock x:Name="LogPathTextBlock" Grid.Row="7" Grid.Column="1" VerticalAlignment="Center" Foreground="{StaticResource TextDarkBrush}" FontWeight="Medium" TextTrimming="CharacterEllipsis" Margin="0,4,0,8" />
                        </Grid>
                    </Border>
                </TabItem>
            </TabControl>
        </Grid>
    </DockPanel>
</Window>
