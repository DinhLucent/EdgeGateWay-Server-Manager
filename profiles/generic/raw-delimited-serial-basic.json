{
  "lifecycle": {
    "enabled": true,
    "autoConnect": true,
    "mode": "edge_agent_first"
  },
  "capture": {
    "type": "serial",
    "serial": {
      "baudRate": 9600,
      "dataBits": 8,
      "parity": "none",
      "stopBits": "one",
      "flowControl": "none",
      "readTimeoutMs": 200,
      "writeTimeoutMs": 2000,
      "readCoalesceMs": 15,
      "maxBufferBytes": 1048576
    }
  },
  "protocol": {
    "type": "raw",
    "encoding": "ascii",
    "raw": {
      "mode": "delimited_text",
      "delimiter": "CRLF",
      "maxMessageBytes": 65536
    },
    "parser": {
      "type": "none",
      "enabled": false
    }
  },
  "observability": {
    "probeEnabled": false,
    "logLevel": "info"
  }
}
